{
  "openapi": "3.0.0",
  "info": {
    "title": "Rentx Documentation",
    "description": "Projeto criando aplicação de uma API rest capítulo 03",
    "version": "1.0.0",
    "contact": {
      "name": "Eduardo R. Durães",
      "email": "eduardodurae.bsi@gmail.com"
    }
  },
  "paths": {
    "/categories": {
      "post": {
        "tags":["Category"],
        "description": "Create a new category",
        "security":[
            {
                "bearerAuth":[]
            }
        ],
        "summary": "create a category",
        "requestBody":{
            "content":{
                "application/json":{
                    "schema":{
                        "type": "object",
                        "properties": {
                            "name":{
                                "type": "string"
                            },
                            "description":{
                                "type": "string"
                            }
                        },
                        "example":{
                            "name":"category name sample",
                            "description":"category description sample"
                        }
                    }
                }
            }
        },
        "responses": {
            "201":{
                "description":"Created"
            },
            "400":{
                "description": "category already exists"
            }
        }
      },
      "get": {
        "tags": [
            "Category"
        ],
        "description": "List all category",
        "summary": "list all category",
        "responses": {
            "200":{
                "description": "Success",
                "content": {
                    "application/json":{
                        "schema":{
                            "type":"array",
                            "items":{
                                "type":"object",
                                "properties":{
                                    "name":{
                                        "type":"string"
                                    },
                                    "descripton":{
                                        "type":"string"
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
      }
    },
    "/categories/import": {
      "post": {
        "tags": ["Category"],
        "description": "Import file with list in the categories",
        "security": [
            {
                "bearerAuth": []
            }
        ],
        "summary": "import file categories",
        "requestBody":{
            "content":{
                "multipart/form-data": {
                    "schema": {
                        "type": "object",
                        "properties": {
                            "file": {
                                "type": "string",
                                "format": "binary"
                            }
                        }
                    }
                }
            }
        },
        "responses": {
            "201":{
                "descripiton": "Success"
            }
        }
      }
    },
    "/specifications": {
      "post": {
        "tags": ["Specifications"],
        "description": "Create a new category",
        "security": [
            {
                "bearerAuth": []
            }
        ],
        "summary": "create a category",
        "requestBody":{
            "content":{
                "application/json":{
                    "schema":{
                        "type": "object",
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "description": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "responses": {
            "201":{
                "description":"Created"
            },
            "400":{
                "description":"Bad Request"
            }
        }
      }
    },
    "/cars/images/{id}":{
        "post":{
            "tags":["Upload images"],
            "description": "Upload images",
            "security":[
                {"bearerAuth": []}
            ],
            "parameters":[
                {
                    "name":"id",
                    "in": "path",
                    "description":"Car id",
                    "required": true,
                    "schema":{
                        "type":"string"
                    }

                }
            ],
            "requestBody":{
                "content":{
                    "multipart/form-data":{
                        "schema": {
                            "type":"object",
                            "properties": {
                                "images": {
                                    "type": "array",
                                    "items": {
                                        "type": "string",
                                        "format": "binary"
                                    }
                                }
                            }
                        }
                    }
                }
            },
            "responses":{
                "201":{
                    "description":"Created"
                }
            }
        }
    },
    "/sessions":{
        "post":{
            "tags":["Session"],
            "summary":"Authentication user",
            "description":"Authentication user",
            "requestBody":{
                "content":{
                    "application/json":{
                        "schema":{
                            "type":"object",
                            "properties": {
                                "email":{
                                    "type":"string"
                                },
                                "password": {
                                    "type":"string"
                                }
                            }
                        }
                    }
                }
            },
            "responses": {
                "200": {
                    "description": "Success"
                },
                "400": {
                    "description": "E-mail or password incorrect!"
                }
            }
        }
    }
  },
  "components":{
    "securitySchemes":{
        "bearerAuth":{
            "type":"http",
            "scheme": "bearer",
            "bearerFormat":"JWT"
        }
    }
  }
}
