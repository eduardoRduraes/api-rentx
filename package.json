    "dev": "ts-node-dev -r tsconfig-paths/register --inspect=0.0.0.0:9229 --transpile-only --ignore-watch node_modules --respawn --poll  src/shared/infra/http/server.ts",
    "debug": "cross-env NODE_ENV=debug ts-node-dev -r tsconfig-paths/register --inspect=0.0.0.0:9229 --transpile-only --ignore-watch node_modules --respawn src/shared/infra/http/server.ts",
    "swagger-autogen": "node swagger.js",
    "typeorm": "ts-node-dev -r tsconfig-paths/register node_modules/typeorm/cli.js",
    "seed:admin": "ts-node-dev src/shared/infra/typeorm/seed/admin.ts",
    "up": "docker-compose up -d",
    "docker:start": "docker start rentx",
    "docker:stop": "docker stop rentx",
    "docker:restart": "docker restart rentx",
    "logs": "docker logs rentx -f"
  },
